# Production Environment Variables - DO NOT COMMIT REAL SECRETS
# Copy from .env and replace with actual production values

# MongoDB - Use MongoDB Atlas in production
MONGO_URI=your_production_mongodb_uri_here

# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Secret - Use a strong, random string (min 32 characters)
JWT_SECRET=your_strong_production_jwt_secret_min_32_chars

# Mailtrap - Ensure HTTPS endpoint is used
MAILTRAP_TOKEN=your_production_mailtrap_token
MAILTRAP_ENDPOINT=https://send.api.mailtrap.io/

# Client URL (Production Frontend URL)
CLIENT_URL=https://yourdomain.com

# API URL (Production Backend URL)
API_URL=https://api.yourdomain.com
